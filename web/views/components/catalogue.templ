package components

import "workshop/internal/domain/sighting"

templ Catalogue(sightings []sighting.Sighting) {
	<table class="catalogue">
		<thead>
			<tr>
				<th scope="col">No.</th>
				<th scope="col"><span class="visually-hidden">Photo</span></th>
				<th scope="col">Body</th>
				<th scope="col">Observed</th>
				<th scope="col">Where</th>
				<th scope="col">Observer</th>
			</tr>
		</thead>
		<tbody>
			for i, s := range sightings {
				<tr id={ rowID(s) }>
					<td class="catalogue__no">{ catalogueNo(i) }</td>
					<td class="catalogue__photo">
						if m, ok := firstPhoto(s.Media); ok {
							<img src={ m.URL } alt={ altText(m) } loading="lazy" width="56" height="56"/>
						} else {
							<span class="catalogue__nophoto" aria-hidden="true"></span>
						}
					</td>
					<td class="catalogue__body">
						<span class={ "sky__dot", "star--" + group(s.Species.Class) } aria-hidden="true"></span>
						<span>
							<b>{ displayName(s.Species) }</b>
							if s.Species.ScientificName != "" {
								<small>{ s.Species.ScientificName }</small>
							}
						</span>
					</td>
					<td data-label="Observed">
						<time datetime={ s.HappenedAt.Format("2006-01-02") }>{ s.HappenedAt.Format("2 Jan 2006") }</time>
						if s.IndividualCount != nil {
							<small>{ individuals(*s.IndividualCount) }</small>
						}
					</td>
					<td data-label="Where">{ place(s.Location) }</td>
					<td data-label="Observer">
						if s.RecordedBy != "" {
							{ s.RecordedBy }
						} else {
							<span class="muted">Not recorded</span>
						}
					</td>
				</tr>
			}
		</tbody>
	</table>
}
