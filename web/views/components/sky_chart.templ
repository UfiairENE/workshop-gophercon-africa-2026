package components

import "workshop/internal/domain/sighting"

templ SkyChart(sightings []sighting.Sighting) {
	{{ points := stars(sightings) }}
	<figure class="sky">
		<div class="sky__panel">
			<svg class="sky__svg" viewBox="0 0 360 180" role="img" aria-label={ skyLabel(points) }>
				<g class="sky__grid" aria-hidden="true">
					for _, x := range gridMeridians {
						<line x1={ coord(x) } y1="0" x2={ coord(x) } y2="180"></line>
					}
					for _, y := range gridParallels {
						<line x1="0" y1={ coord(y) } x2="360" y2={ coord(y) }></line>
					}
					<line class="sky__equator" x1="0" y1="90" x2="360" y2="90"></line>
				</g>
				<g class="sky__stars">
					for i, p := range points {
						<a href={ templ.URL(p.Anchor) } tabindex="-1">
							<circle
								class={ "star", "star--" + p.Group, templ.KV("star--twinkle", i%7 == 0) }
								cx={ coord(p.X) }
								cy={ coord(p.Y) }
								r="1.3"
							>
								<title>{ p.Label }</title>
							</circle>
						</a>
					}
				</g>
			</svg>
		</div>
		<figcaption class="sky__legend">
			for _, g := range legend(points) {
				<span class="sky__key"><i class={ "sky__dot", "star--" + g.Name } aria-hidden="true"></i>{ groupNames[g.Name] } <b>{ g.Count }</b></span>
			}
		</figcaption>
	</figure>
}
