package components

import (
	"cmp"
	"workshop/internal/domain/sighting"
)

templ Gallery(items []sighting.Media) {
	if len(items) == 0 {
		<p class="gallery__empty">No photos were recorded for this sighting.</p>
	} else {
		<ul class="gallery">
			for _, m := range items {
				<li class="gallery__item">
					if m.Type == "StillImage" {
						<button type="button" class="gallery__open" data-lightbox={ m.URL } data-caption={ altText(m) }>
							<img src={ m.URL } alt={ altText(m) } loading="lazy"/>
						</button>
					} else {
						<a href={ templ.URL(m.URL) } rel="noopener">{ altText(m) }</a>
					}
					if m.Creator != "" {
						<p class="gallery__credit mono">© { m.Creator }</p>
					}
				</li>
			}
		</ul>
	}
}

func altText(m sighting.Media) string {
	return cmp.Or(m.Title, m.Description, "Sighting photo")
}
