package pages

import (
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ Sea(sightings []sighting.Sighting) {
	{{ sum := sighting.Summarise(sightings) }}
	{{ byYear := sighting.CountByYear(sightings) }}
	@layout.Base(layout.BaseProps{
		Title:       "Sea life · Earthbound Observatory",
		Current:     "Sea life",
		Description: "Whales, dolphins, sharks, turtles and seabirds from GBIF, charted like the night sky.",
	}) {
		<section class="hero">
			<div class="wrap">
				<p class="eyebrow">An atlas of the living ocean</p>
				<h1 class="hero__title">Life in the deep, charted like the stars.</h1>
			</div>
			<div class="hero__planet">
				@components.ThreeScene(components.ThreeSceneProps{Scene: "planet"})
			</div>
		</section>
		if len(sightings) == 0 {
			<section class="section">
				<div class="wrap">
					<h2 class="section__title">The sky is empty tonight</h2>
					<p>No sightings have been recorded yet. Run <code>go run . db seed</code> and refresh.</p>
				</div>
			</section>
		} else {
			<section class="section reveal" id="chart" aria-labelledby="chart-title">
				<div class="wrap">
					<header class="section__head">
						<h2 class="section__title" id="chart-title">Sky chart</h2>
						<p class="section__lede">Each point of light is one sighting of sea life, placed by where on Earth it was seen. Hover a point to name it, click to find it in the catalogue.</p>
					</header>
					@components.SkyChart(sightings)
				</div>
			</section>
			<section class="section reveal" id="almanac" aria-labelledby="almanac-title">
				<div class="wrap">
					<header class="section__head">
						<h2 class="section__title" id="almanac-title">Almanac</h2>
					</header>
					<dl class="figures">
						<div><dt>Observations</dt><dd>{ sum.Sightings }</dd></div>
						<div><dt>Bodies</dt><dd>{ sum.Species }</dd></div>
						<div><dt>Countries</dt><dd>{ sum.Countries }</dd></div>
						<div><dt>Observers</dt><dd>{ sum.Recorders }</dd></div>
					</dl>
					<div class="plates">
						<article class="plate plate--warm">
							<h3>Observations per year</h3>
							<p>{ sum.Earliest.Year() } to { sum.Latest.Year() }, busiest in { components.BusiestYear(byYear) }</p>
							@components.Sparkline("Sightings", byYear, sum.Earliest.Year(), sum.Latest.Year())
						</article>
						<article class="plate plate--cool">
							<h3>Most-observed bodies</h3>
							@components.Bars(components.TopBodies(sightings, 6))
						</article>
					</div>
				</div>
			</section>
			<section class="section reveal" id="catalogue" aria-labelledby="catalogue-title">
				<div class="wrap">
					<header class="section__head">
						<h2 class="section__title" id="catalogue-title">Catalogue</h2>
						<p class="section__lede">{ sum.Sightings } observations, newest first.</p>
					</header>
					@components.Catalogue(sightings)
				</div>
			</section>
		}
	}
}
