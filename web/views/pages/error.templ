package pages

import (
	"strconv"
	"workshop/web/views/layout"
)

templ Error(message string, code int) {
	@layout.Base(layout.BaseProps{
		Title: "Error " + strconv.Itoa(code),
	}) {
		<section class="wrap page">
			<p class="mono eyebrow">Error { strconv.Itoa(code) }</p>
			<h1>Something went wrong</h1>
			<p class="lede">{ message }</p>
			<p><a class="btn btn--lime" href="/">Back to sightings</a></p>
		</section>
	}
}
